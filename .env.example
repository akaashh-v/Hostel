# ==========================================
# HOSTEL MESS MANAGEMENT SYSTEM ENVIRONMENT
# ==========================================

# Application Port
PORT=5173
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostel_mess?schema=public"

# Security & Session Secrets
JWT_SECRET="hostel_mess_super_secure_jwt_secret_key_2026"
SESSION_SECRET="hostel_mess_cookie_session_secret_key_2026"
COOKIE_DOMAIN=""
SECURE_COOKIES=false # Set to true in production HTTPS

# Administrator Bootstrap Credentials (Initial Seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@123"
ADMIN_FULL_NAME="Chief Warden"
ADMIN_PHONE="admin"

# Host & Client Origins (CORS)
CLIENT_ORIGIN="http://localhost:5173"

# Application Timezone
TZ="Asia/Kolkata"

# Image Storage Configuration (Optional Cloudinary / Local)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
